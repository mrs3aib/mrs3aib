# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Optional. Development defaults to `info` (startup banner + request logs).
# Set `warn` for a quieter terminal, or `debug` for more detail.
# Production is always `warn` regardless of this.
# LOG_LEVEL=debug

# Browser origins allowed to call this API, comma-separated.
# Defaults to the local dev URLs of `admin` (5173) and `web` (3000).
# A production deploy that leaves this unset still boots, but every browser
# request from the real site is blocked by CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Database (Railway Postgres)
# Railway: New -> Database -> Add PostgreSQL, then reference the connection
# string from the API service rather than pasting credentials:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   DIRECT_URL=${{Postgres.DATABASE_URL}}
# Prefer the private URL — it keeps traffic inside the project.
# ---------------------------------------------------------------------------
# Runtime queries. Railway's Postgres has no transaction pooler, so this needs
# no `?pgbouncer=true` — that flag belongs to a pooled Supabase URL.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/railway
# Used by `prisma migrate`, which cannot run through a transaction pooler.
# Without a pooler in front there is nothing to bypass, so on Railway this is
# the same URL as above. It is still required: schema.prisma references it and
# the server aborts at startup when it is unset.
DIRECT_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/railway

# ---------------------------------------------------------------------------
# Auth secrets — at least 32 characters each.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---------------------------------------------------------------------------
# Cloudflare R2 — media storage. All four are required; the server will not
# boot without them.
# ---------------------------------------------------------------------------
# Account-level endpoint, no bucket name appended. A bucket with an EU/FedRAMP
# jurisdiction gains a segment: https://<account-id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=

# ---------------------------------------------------------------------------
# Public site cache revalidation (optional)
# After a CMS or session change the API POSTs to WEB_REVALIDATE_URL with
# REVALIDATE_SECRET so the site drops its cached copy and the edit appears
# immediately. Both must be set — unset simply disables it, and edits appear
# within the site's hour-long cache instead.
# REVALIDATE_SECRET must match the site's and be at least 16 characters.
# ---------------------------------------------------------------------------
WEB_REVALIDATE_URL=
REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Admin accounts for `npm run prisma:seed:admin` (never read by the server).
# Either one admin:
#   SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD / SEED_ADMIN_NAME
# or several, as a JSON array — `name` is optional:
#   SEED_ADMINS='[{"email":"a@example.com","password":"...","name":"A"}]'
# Fill these in your own .env, which is git-ignored. Leave them blank here.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMINS=
