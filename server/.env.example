# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Optional. Development defaults to `info` (startup banner + request logs).
# Set `warn` for a quieter terminal, or `debug` for more detail.
# Production is always `warn` regardless of this.
# LOG_LEVEL=debug

# Browser origins allowed to call this API, comma-separated.
# Defaults to the local dev URLs of `admin` (5173) and `web` (3000).
# A production deploy that leaves this unset still boots, but every browser
# request from the real site is blocked by CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# Both URLs: Project Settings -> Database -> Connection string.
# ---------------------------------------------------------------------------
# Transaction-mode pooler (IPv4-only) — runtime queries.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Session-mode pooler — used by `prisma migrate`, which cannot run through a
# transaction pooler. Omitting it fails at migrate time, not at boot.
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Auth secrets — at least 32 characters each.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---------------------------------------------------------------------------
# Cloudflare R2 — media storage. All four are required; the server will not
# boot without them.
# ---------------------------------------------------------------------------
# Account-level endpoint, no bucket name appended. A bucket with an EU/FedRAMP
# jurisdiction gains a segment: https://<account-id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=

# ---------------------------------------------------------------------------
# Public site cache revalidation (optional)
# After a CMS or session change the API POSTs to WEB_REVALIDATE_URL with
# REVALIDATE_SECRET so the site drops its cached copy and the edit appears
# immediately. Both must be set — unset simply disables it, and edits appear
# within the site's hour-long cache instead.
# REVALIDATE_SECRET must match the site's and be at least 16 characters.
# ---------------------------------------------------------------------------
WEB_REVALIDATE_URL=
REVALIDATE_SECRET=
