# Backend API base URL, e.g. http://localhost:4000
#
# Leave EMPTY (or omit this file) to run the site purely on the placeholder
# images in lib/data.ts. Every backend call degrades to those placeholders on
# failure, so setting this wrong breaks nothing — the site just stays static.
NEXT_PUBLIC_API_BASE_URL=

# Public site origin used in share and QR links, e.g. https://yahyaalsaib.com
# Unset falls back to the browser's current origin, which is correct locally.
NEXT_PUBLIC_SITE_URL=

# Shared secret for POST /api/revalidate, which drops the cached CMS content so
# an admin's save appears immediately instead of waiting out the hour-long
# cache. Must match REVALIDATE_SECRET on the API server, and be at least 16
# characters. Leave empty to disable revalidation: the endpoint then refuses
# every request (503) rather than becoming a public cache-buster.
REVALIDATE_SECRET=

# Origins allowed to open a CMS preview (the admin dashboard), comma-separated.
# The preview endpoint holds an unsaved draft, so only the dashboard may call
# it. Defaults to the local admin dev URL; set this in production or the
# preview will not work there.
CMS_PREVIEW_ORIGINS=http://localhost:5173
